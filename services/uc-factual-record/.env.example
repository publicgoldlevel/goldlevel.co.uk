# Non-secret example only. The host installer creates its own deploy.env.
# Keep real runtime data outside this service and outside repository history.
PUBLIC_ORIGIN=https://goldlevel.co.uk
BASE_PATH=/uc_factual_record
PRIVATE_RUNTIME_DIR=/absolute/private-runtime
PORTAL_RELEASE_ID=replace-with-installed-release-id
# A digest is mandatory; resolve/review the actual supported image at deployment.
# NODE_IMAGE=node:26.4.0-bookworm-slim@sha256:REPLACE_WITH_64_HEX_DIGEST
